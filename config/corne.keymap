#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        thirdLayer {
            bindings = <&mo 0>;
            key-positions = <37 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y          &kp U  &kp I          &kp O    &kp P          &kp LEFT_BRACKET
&mt LCTRL ESCAPE  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H          &kp J  &kp K          &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N          &kp M  &kp COMMA      &kp DOT  &kp SLASH      &kp ENTER
                                &kp LGUI  &mo 2  &kp SPACE    &kp BACKSPACE  &mo 1  &kp RIGHT_ALT
            >;
        };

        nav_num {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB         &kp N1  &kp N2  &kp N3    &kp N4   &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0    &kp BSPC
&kp F2          &kp F4  &kp F5  &kp F10   &kp F11  &kp F12      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp HOME  &kp END
&kp LEFT_SHIFT  &trans  &trans  &trans    &trans   &trans       &trans    &trans    &trans    &trans     &trans    &trans
                                &kp LGUI  &mo 3    &kp SPACE    &kp RET   &trans    &kp RALT
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB           &kp EXCL          &kp AT            &kp HASH          &kp DLLR          &kp PRCNT     &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR           &kp RPAR       &kp BSPC
&mt LCTRL ESCAPE  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)    &kp MINUS  &kp EQUAL  &kp GRAVE        &kp RIGHT_BRACKET  &kp BACKSLASH  &kp GRAVE
&kp LEFT_SHIFT    &trans            &trans            &trans            &trans            &trans        &kp UNDER  &kp PLUS   &kp TILDE        &kp RIGHT_BRACE    &kp PIPE       &kp TILDE
                                                      &kp LGUI          &trans            &kp SPACE     &kp RET    &mo 3      &kp RALT
            >;
        };

        settings {
            display-name = "Lower";
            bindings = <
&kp TAB     &trans        &trans        &trans        &trans        &trans          &trans          &kp C_VOLUME_UP    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &ext_power EP_TOG
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_PREVIOUS  &kp C_PLAY_PAUSE   &kp C_NEXT            &trans                &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans          &kp C_VOLUME_DOWN  &trans                &trans                &trans  &bootloader
                                        &kp LGUI      &trans        &kp SPACE       &kp RET         &trans             &kp RALT
            >;
        };
    };
};
