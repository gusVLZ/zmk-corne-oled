#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Press LOWER + RAISE together -> ADJUST (F keys / media / Bluetooth management layer)
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T      |   |  Y         |  U         |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G      |   |  H         |  J         |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B      |   |  N         |  M         |  ,  |  .  |  /  | SHFT |
            //                    | GUI | LWR |  SPC    |   | ENT        | BKSP/RSE   | ALT |
            //
            // Right-hand 2nd thumb key (to the right of ENT): tap = backspace, hold = RAISE layer

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U            &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J            &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LGUI  &mo 1  &kp SPACE    &kp ENTER  &lt 2 BACKSPACE  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  ESC |  1  |  2  |  3  |  4  |  5    |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CAPS | LFT | DWN |  UP | RGT |       |   | Vo- | MUT | Vo+ |     |     |      |
            // | SHFT |     |     |     |     |       |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |   | ENT |     | BASE |
            //
            // BASE = &mo 0, hold to temporarily return to LAYER_0.
            // DYA Studio's Default Layer panel can set this layer as the base layer. Once
            // that happens, the thumb area of this layer (all &trans) becomes a dead zone:
            // no way back to RAISE (no &studio_unlock), no way into ADJUST. Keep an &mo 0 fallback.

            bindings = <
&kp ESCAPE  &kp N1    &kp N2    &kp N3  &kp N4     &kp N5    &kp N6  &kp N7        &kp N8      &kp N9        &kp N0  &trans
&kp CAPS    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none     &none   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &trans  &trans
&kp LSHFT   &trans    &trans    &trans  &trans     &trans    &trans  &trans        &trans      &trans        &trans  &trans
                                &trans  &trans     &trans    &trans  &trans        &mo 0
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  DEL |
            // | CTRL |  A  | BT1 | BT2 | BT3 |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT | OUT |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | STUDIO | ->ADJ |     |   | ENT |     | BASE |
            //
            // Left-hand 1st thumb key: unlock DYA Studio; 2nd: hold to enter the ADJUST layer;
            // rightmost: &mo 0, hold to briefly return to LAYER_0 (escape hatch when RAISE is the base layer).
            //
            // How to enter: LAYER_0 key #7 (right-hand 2nd thumb key, &lt 2): tap = backspace,
            // hold = this layer; you can also press LOWER + RAISE together (conditional layer) to go straight to ADJUST.
            //
            // ⚠️ Output switching (USB / BLE) was moved to the ADJUST layer, and `&out OUT_USB` changed to
            //    `&out OUT_TOG`. The old OUT_USB was sticky: once pressed, if no cable is plugged in,
            //    the keyboard has no output at all (BLE output is stopped), looking like "the keyboard suddenly broke";
            //    and RAISE has only one way in, almost no way back. OUT_TOG toggles both ways, never dead-ends.

            bindings = <
&trans  &kp EXCL     &kp AT        &kp HASH      &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR  &kp RPAR  &kp DEL
&trans  &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans       &kp MINUS  &kp EQUAL  &kp LBKT      &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_TOG  &trans        &trans        &trans        &trans       &kp UNDER  &kp PLUS   &kp LBRC      &kp RBRC  &kp PIPE  &kp TILDE
                                  &studio_unlock  &mo 3         &trans        &trans     &trans     &mo 0
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1 | F2 | F3 | F4 | F5 | F6  |   | F7  | F8  | F9  | F10 | F11 | F12   |
            // | bri+|    |prev| PP |next|     |   |     | MUT | Vo- | Vo+ |     |       |
            // | bri-|    |    |    |    | BT1 |   | BT2 |     |     |     |     | BTCLR |
            //                      | BTLDR | OUT | UNLK |     |     | BASE |
            //
            // How to enter: press LOWER + RAISE together (conditional layer), or hold the left-hand
            // 2nd thumb key while in RAISE.
            //
            // BTLDR = enter bootloader; placed at the leftmost GUI position, hard to hit by mistake.
            // OUT   = &out OUT_TOG, toggles between USB / BLE. Do **not** use &out OUT_USB:
            //         it is sticky: after switching to it with no cable plugged in there is no output at all,
            //         the keyboard goes "mute", and it is very hard to undo from the ADJUST layer.
            // UNLK  = &studio_unlock, a backup unlock position when Studio is locked (RAISE has one too).
            // BASE  = &mo 0, hold to temporarily return to LAYER_0 (escape hatch when ADJUST is the base layer).
            //
            // BT_CLR sits at the far right of this layer, away from the main keys, so pairing is not erased by mistake.

            bindings = <
&kp F1        &kp F2  &kp F3     &kp F4    &kp F5     &kp F6        &kp F7        &kp F8    &kp F9      &kp F10      &kp F11      &kp F12
&kp C_BRI_UP  &trans  &kp C_PREV &kp C_PP  &kp C_NEXT &trans        &trans        &trans    &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
&kp C_BRI_DN  &trans  &trans     &trans    &trans     &bt BT_SEL 0  &bt BT_SEL 1  &trans    &trans      &trans       &trans       &bt BT_CLR
                                           &bootloader  &out OUT_TOG  &studio_unlock  &trans  &trans      &mo 0
            >;
        };
    };
};
