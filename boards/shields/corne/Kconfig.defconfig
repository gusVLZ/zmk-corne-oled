# Kconfig patch for the Corne shield
#
# ⚠️ Only symbols about "what this board is" are kept here: keyboard name, split role, and
#   the ZMK_SPLIT / display / LVGL defaults inherited from upstream ZMK.
#   All feature switches (ZMK Studio, OS detection, default layer, extension modules...) are not here,
#   but split per half into the .conf files:
#
#     boards/shields/corne/corne_left.conf    left = central: Studio and all RPC
#     boards/shields/corne/corne_right.conf   right = peripheral: receives/applies settings only
#     config/corne.conf                       shared by both halves
#
# Why not `default y`:
# 1) A default in defconfig is a weak default; when a symbol's depends on is unmet it is
#    **silently dropped with no warning at all** — exactly the cause of "it compiles but the feature is off";
# 2) ZMK applies <shield_root>/<shield>.conf automatically by shield name; .conf is an explicit assignment,
#    and an unmet dependency clearly warns "assigned the value 'y' but got 'n'";
#    such warnings in the build log must be zero — any occurrence means the config is wrong.
# 3) The protobuf stubs that *_STUDIO_RPC depends on are generated on the central only.
#    <shield>.conf is naturally isolated per half, so it cannot leak onto the peripheral half.

if SHIELD_CORNE_LEFT

# This keyboard's central (master) half is the left one: the left handles USB / BLE and Studio communication
config ZMK_KEYBOARD_NAME
# Bluetooth device name is limited to 16 bytes
    default "Corne DYA"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CORNE_LEFT || SHIELD_CORNE_RIGHT

config ZMK_SPLIT
    default y

# The defaults below come from ZMK's upstream corne shield and must not be dropped by local overrides
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
